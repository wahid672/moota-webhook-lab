# Local development only. In Vercel, connect Supabase through Storage / Marketplace;
# the integration automatically supplies the Supabase and Postgres variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy fallback for manually configured projects:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Needed only when running database migrations locally:
POSTGRES_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
# Optional direct/non-pooling connection fallback:
# POSTGRES_URL_NON_POOLING=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require

# Moota API token. Keep this secret; never use NEXT_PUBLIC_ prefix.
MOOTA_API_TOKEN=YOUR_MOOTA_PERSONAL_API_TOKEN
# Bank ID of the Sandbox account registered in Moota
MOOTA_SANDBOX_BANK_ID=YOUR_SANDBOX_BANK_ID

# Secret Token created when registering the webhook in Moota.
MOOTA_WEBHOOK_SECRET=YOUR_MOOTA_WEBHOOK_SECRET

# Dashboard protection. Required on Vercel production.
LAB_DASHBOARD_USER=admin
LAB_DASHBOARD_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Optional token reserved for later test tooling.
LAB_TEST_TOKEN=CHANGE_THIS_TO_ANOTHER_RANDOM_VALUE

# Optional: allow a single pending transaction with the exact same amount to match.
AUTO_MATCH_UNIQUE_AMOUNT=true
