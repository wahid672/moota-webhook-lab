# Supabase project settings (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Moota API token. Keep this secret; never use NEXT_PUBLIC_ prefix.
MOOTA_API_TOKEN=YOUR_MOOTA_PERSONAL_API_TOKEN
# Bank ID of the Sandbox account registered in Moota
MOOTA_SANDBOX_BANK_ID=YOUR_SANDBOX_BANK_ID

# Secret Token created when registering the webhook in Moota.
# Moota signs the raw JSON request body using HMAC-SHA256.
MOOTA_WEBHOOK_SECRET=YOUR_MOOTA_WEBHOOK_SECRET

# Dashboard protection. Required on Vercel production.
LAB_DASHBOARD_USER=admin
LAB_DASHBOARD_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Optional token for protected test endpoints (reserved for later test tooling).
LAB_TEST_TOKEN=CHANGE_THIS_TO_ANOTHER_RANDOM_VALUE

# Optional: allow a single pending transaction with the exact same amount to match.
# Exact order code in mutation note/description always has priority.
AUTO_MATCH_UNIQUE_AMOUNT=true
